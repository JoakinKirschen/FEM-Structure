{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assurance evidence bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "catalog_sha256",
    "artifacts",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-assurance-bundle/1.0"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_path",
          "bundle_path",
          "media_type",
          "sha256",
          "byte_length"
        ],
        "properties": {
          "source_path": {
            "type": "string"
          },
          "bundle_path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
