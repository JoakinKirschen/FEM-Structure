{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/structural/automation-api-1.0.schema.json",
  "title": "Structural Automation API request",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "method",
    "params",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-automation/1.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "params": {},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "inspect_system",
          "read_artifacts",
          "validate_models",
          "evaluate_rules",
          "run_analysis"
        ]
      }
    }
  },
  "additionalProperties": false
}
