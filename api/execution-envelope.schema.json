{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/structural/execution-envelope-1.0.json",
  "title": "Structural execution envelope",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "created_at_utc",
    "operation",
    "parameters",
    "inputs",
    "expected_output_media_types",
    "toolchain",
    "resources",
    "retry",
    "cancellation_id",
    "deterministic_profile"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-execution/1.0"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "expected_output_media_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "toolchain": {
      "$ref": "#/$defs/toolchain"
    },
    "resources": {
      "type": "object",
      "required": [
        "cpu_cores",
        "memory_bytes",
        "maximum_runtime_seconds"
      ],
      "properties": {
        "cpu_cores": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_runtime_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "required": [
        "maximum_attempts",
        "initial_backoff_ms",
        "maximum_backoff_ms"
      ],
      "properties": {
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "initial_backoff_ms": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_backoff_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "cancellation_id": {
      "type": "string",
      "format": "uuid"
    },
    "deterministic_profile": {
      "type": "boolean"
    },
    "random_seed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "logical_name",
        "media_type",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "logical_name": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "required": [
        "application_id",
        "application_version",
        "target_triple",
        "compiler"
      ],
      "properties": {
        "application_id": {
          "type": "string",
          "minLength": 1
        },
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "dependency_lock_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "executable_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "container_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
