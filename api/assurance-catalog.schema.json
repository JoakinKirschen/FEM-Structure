{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural.example/schemas/assurance-catalog-1.0.json",
  "title": "Structural assurance catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_name",
    "product_version",
    "published_at_utc",
    "scope_statement",
    "benchmarks",
    "validations",
    "known_limitations",
    "traceability",
    "independent_lab_results"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-assurance-catalog/1.0"
    },
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "product_version": {
      "type": "string",
      "minLength": 1
    },
    "published_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "scope_statement": {
      "type": "string",
      "minLength": 1
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/benchmark"
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitation"
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/traceability"
      }
    },
    "independent_lab_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lab"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "media_type",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "description",
        "unit",
        "minimum",
        "maximum"
      ],
      "properties": {
        "metric_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_id",
        "title",
        "analysis_type",
        "description",
        "inputs",
        "expected_metrics",
        "reference_sources",
        "limitation_ids"
      ],
      "properties": {
        "benchmark_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "analysis_type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "reference_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "default": []
        },
        "expected_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "reference_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_id",
        "benchmark_id",
        "solver_id",
        "solver_version",
        "platform",
        "executed_at_utc",
        "status",
        "observed_metrics",
        "result",
        "notes"
      ],
      "properties": {
        "validation_id": {
          "type": "string"
        },
        "benchmark_id": {
          "type": "string"
        },
        "solver_id": {
          "type": "string"
        },
        "solver_version": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "executed_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "observed_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limitation_id",
        "title",
        "description",
        "affected_components",
        "severity",
        "workaround",
        "open"
      ],
      "properties": {
        "limitation_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "affected_components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severity": {
          "type": "string"
        },
        "workaround": {
          "type": [
            "string",
            "null"
          ]
        },
        "open": {
          "type": "boolean"
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "source",
        "claim",
        "benchmark_ids",
        "evidence_paths"
      ],
      "properties": {
        "requirement_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "benchmark_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "organization",
        "report_reference",
        "issue_date",
        "scope",
        "accreditation_statement",
        "verification_status",
        "report",
        "benchmark_ids",
        "notes"
      ],
      "properties": {
        "result_id": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "report_reference": {
          "type": "string"
        },
        "issue_date": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "string"
        },
        "accreditation_statement": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "enum": [
            "illustrative_unverified",
            "publisher_verified",
            "signature_verified"
          ]
        },
        "report": {
          "$ref": "#/$defs/artifact"
        },
        "benchmark_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
